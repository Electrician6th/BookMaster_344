<Window x:Class="BookMaster_34.View.Windows.ManageCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookMaster_34.View.Windows"
        mc:Ignorable="d"
        Title="ManageCustomerWindow" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Width="900">
    <Grid Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="410"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="410"/>

        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ИД:"/>
            <TextBlock Grid.Row="2" Text="Имя"/>
            <TextBlock  Grid.Row="4" Text="Адрес"/>
            <TextBlock  Grid.Row="6" Text="Город"/>
            
            <TextBox Name="IDclientTb" Grid.Column="2" Width="200" HorizontalAlignment="Left"/>

            <TextBlock Text="Имя клиента:" Grid.Row="2"/>
            <TextBox Name="ClientNameTb" Grid.Column="2" Grid.Row="2" Width="200" HorizontalAlignment="Left"/>

            <TextBlock Text="Адрес клиента:" Grid.Row="4"/>
            <TextBox Name="AddressClientTb" Grid.Column="2" Grid.Row="4" Width="200" HorizontalAlignment="Left"/>

            <TextBlock Text="Почтовый индекс:" Grid.Row="6"/>

            <TextBox Name="indexTb" Grid.Row="6" Grid.Column="2" Margin="0 5 130 0"/>

            <ComboBox Name="CityCmb" Grid.Column="2" SelectedValuePath="Id" DisplayMemberPath="Name" SelectedIndex="0" Grid.Row="6" Width="110" Margin="80 5 0 0" HorizontalAlignment="Left"/>

        </Grid>

        <Grid Grid.Column="2" Grid.ColumnSpan="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Номер телефона:" Grid.Row="1"/>
            <TextBox Name="PhoneCustomerTb" Grid.Column="2" Grid.Row="1" Width="200" HorizontalAlignment="Left"/>

            <TextBlock Text="Электронная почта:" Grid.Row="3"/>
            <TextBox Name="EmailCustomerTb" Grid.Column="2" Grid.Row="3" Width="200" HorizontalAlignment="Left"/>

            <Grid Grid.Row="5" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                
                <Button Name="SaveBtn" Content="Сохранить" Click="SaveBtn_Click"  Width="100" HorizontalAlignment="Left"/>
                <Button Name="EditBtn" Content="Редактировать" Click="EditBtn_Click"  Width="100" HorizontalAlignment="Left" Visibility="Hidden"/>
                <Button Name="CancelBtn" Grid.Column="2" Content="Отмена" Width="100" HorizontalAlignment="Right" Click="CancelBtn_Click"  Cursor="Hand"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
